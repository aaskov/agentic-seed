{
  "name": "${localWorkspaceFolderBasename}",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "remoteUser": "vscode",
  // The bind mounts need the folders to exist, also on CI runners without a key or a token.
  "initializeCommand": "mkdir -p \"$HOME/.config/agent-bot\" \"$HOME/.config/claude-agent\"",
  "mounts": [
    "source=${localEnv:HOME}/.config/agent-bot,target=/mnt/agent-bot,type=bind,readonly",
    // The Claude token for login-free agent containers (docs/adr/0006).
    "source=${localEnv:HOME}/.config/claude-agent,target=/mnt/claude-agent,type=bind,readonly"
  ],
  "postCreateCommand": ".devcontainer/post-create.sh"
}
