# The GitHub App that agents use as their identity (docs/adr/0005).
# These values are not secret. The private key stays on the host, in
# ~/.config/agent-bot/private-key.pem. If AGENT_BOT_APP_ID is empty, the bot is off.
AGENT_BOT_APP_ID={{ bot_app_id }}
AGENT_BOT_APP_SLUG={{ bot_app_slug }}
AGENT_BOT_REPO={{ github_owner }}/{{ project_name }}
